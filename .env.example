# ==============================================================================
# СПОРТИВНАЯ ПЛАТФОРМА «ТОЧКА СБОРА» — КОНФИГУРАЦИЯ ОКРУЖЕНИЯ (.env.example)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_DB=sportplatform
POSTGRES_USER=sportuser
POSTGRES_PASSWORD=sportpass_dev_only
POSTGRES_PORT=5432

# --- Backend Server & Security ---
BACKEND_PORT=8080
JWT_SECRET=SportPlatformSuperSecretKeyForJwtSigning2026MustBeAtLeast32BytesLong!
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- Первоначальный Администратор (создаётся автоматически при старте) ---
INITIAL_ADMIN_EMAIL=admin@sportplatform.ru
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ADMIN_NAME=Главный Администратор

# --- Начальные демонстрационные/тестовые данные ---
# При true создаются тестовые пользователи, клубы, мероприятия, тикеты и обсуждения
APP_SEED_DEMO_DATA=true

# --- Хранилище вложений и лимиты загрузки ---
STORAGE_UPLOAD_DIR=/var/lib/sportplatform/uploads
MAX_IMAGE_SIZE_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=15728640
MAX_VIDEO_SIZE_BYTES=52428800

# --- Уведомления и Планировщик регулярных встреч ---
REMINDER_FIRST_HOURS_BEFORE=24
REMINDER_SECOND_HOURS_BEFORE=2
RECURRING_GENERATION_WEEKS_AHEAD=4

# --- Интеграция с VK-ботом ---
# Режимы: TEST_LOG (работает без реального токена, логирует и сохраняет в БД) или REAL (реальный VK Bots Long Poll API)
VK_BOT_MODE=TEST_LOG
VK_GROUP_ID=0
VK_COMMUNITY_TOKEN=
VK_API_VERSION=5.199
VK_CLUB_URL=https://vk.com/club0

# --- Frontend ---
FRONTEND_PORT=3000
